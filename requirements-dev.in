# Development and CI tools, on top of requirements.txt. requirements-dev.txt is generated from this file:
#   pip-compile --generate-hashes --strip-extras --allow-unsafe -o requirements-dev.txt requirements-dev.in
# Install both: pip install --require-hashes -r requirements.txt -r requirements-dev.txt
# Anything these share with the image stays on exactly the version the image uses.
-c requirements.txt
pytest
pytest-asyncio
ruff
